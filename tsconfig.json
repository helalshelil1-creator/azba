{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@azba/*": [
        "packages/*/src"
      ],
      "@azba/database": [
        "packages/database/src"
      ],
      "@azba/ui": [
        "packages/ui/src"
      ],
      "@azba/shared": [
        "packages/shared/src"
      ],
      "@azba/config": [
        "packages/config/src"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/dist",
    "**/.next",
    "**/build"
  ]
}