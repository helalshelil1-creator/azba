// AZBA | عزبة - Database Schema
// PostgreSQL + Prisma ORM
// All models for: Users, Investments, Farms, Animals, Veterinary, Financial, Operations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  FINANCE_MANAGER
  ACCOUNTANT
  INVESTMENT_MANAGER
  FARM_MANAGER
  VETERINARIAN
  FARM_EMPLOYEE
  PROCUREMENT_OFFICER
  SALES_MANAGER
  CUSTOMER_SUPPORT
  INVESTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  BANNED
}

enum KYCStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum InvestmentStatus {
  DRAFT
  PENDING_PAYMENT
  RESERVED
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ProjectStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  FUNDING
  FUNDED
  ACTIVE
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum AnimalType {
  CATTLE
  BUFFALO
  SHEEP
  GOAT
  CALF
  FATTENING
  DAIRY
  BREEDING
}

enum AnimalStatus {
  ACTIVE
  SOLD
  DECEASED
  TRANSFERRED
  QUARANTINE
}

enum HealthStatus {
  HEALTHY
  UNDER_TREATMENT
  RECOVERING
  CRITICAL
  QUARANTINE
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  DIVIDEND
  FEE
  REFUND
  TRANSFER
  PAYMENT
  EXPENSE
  REVENUE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CARD
  WALLET
  SANDBOX
  MOBILE_PAYMENT
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum NotificationType {
  INVESTMENT_CREATED
  PAYMENT_CONFIRMED
  CONTRACT_ISSUED
  WEIGHT_UPDATED
  VETERINARY_REPORT
  PROJECT_STATUS_CHANGED
  SALE_APPROVED
  DISTRIBUTION_APPROVED
  WITHDRAWAL_REQUEST
  SYSTEM_ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  INVESTMENT_CONTRACT
  PURCHASE_DOCUMENT
  SALE_DOCUMENT
  VETERINARY_REPORT
  INVOICE
  PAYMENT_RECEIPT
  INSURANCE_DOCUMENT
  KYC_DOCUMENT
  OTHER
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String?   @unique
  passwordHash  String
  firstName     String
  lastName      String
  avatar        String?
  role          UserRole  @default(INVESTOR)
  status        UserStatus @default(PENDING_VERIFICATION)
  emailVerified DateTime?
  failedLoginAttempts Int @default(0)
  preferredLang String    @default("ar")
  timezone      String    @default("Africa/Cairo")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([status])
    sessions Session[]

    loginAttempts LoginAttempt[]

    investorProfile InvestorProfile?

    kycRecords KYCRecord[]

    managedFarms Farm[] @relation("FarmManager")

    farmEmployments FarmEmployee[]

    veterinaryReports VeterinaryReport[]

    createdProjects Project[] @relation("ProjectCreator")



    reservations ShareReservation[]

    investments Investment[]

    wallet Wallet?

    payments Payment[]

    goodsReceipts GoodsReceipt[]

    tasks Task[] @relation("TaskAssignee")


    supportTickets SupportTicket[] @relation("UserTickets")


    supportMessages SupportMessage[]

    notifications Notification[]

    auditLogs AuditLog[]

    approvalSteps ApprovalStep[]

  @@map("users")

}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")

}

model LoginAttempt {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
  @@map("login_attempts")

}

// ============================================
// INVESTOR & KYC
// ============================================

model InvestorProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  nationalId        String?  @unique
  passportNumber    String?  @unique
  dateOfBirth       DateTime?
  gender            String?
  country           String   @default("EG")
  annualIncome      Decimal? @db.Decimal(15, 2)
  preferredAnimalTypes AnimalType[]
  minInvestmentAmount Decimal? @db.Decimal(15, 2)
  maxInvestmentAmount Decimal? @db.Decimal(15, 2)
  preferredProjectDuration Int? // in months
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([nationalId])
  @@index([userId])
  @@map("investor_profiles")

}

model KYCRecord {
  id              String     @id @default(uuid())
  userId          String
  documentType    String     // national_id, passport, proof_of_address, bank_statement
  documentNumber  String?
  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String
  status          KYCStatus  @default(PENDING)
  reviewedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("kyc_records")

}

// ============================================
// ROLES & PERMISSIONS
// ============================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  level       Int      @default(0) // higher = more permissions
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       User[]


  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  name        String @unique // e.g., "project:create", "investment:read"
  displayName String
  description String?
  resource    String // project, investment, farm, animal, etc.
  action      String // create, read, update, delete, approve, etc.
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([resource])
  @@index([action])

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  grantedAt    DateTime @default(now())
  grantedBy    String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ============================================
// FARMS & INFRASTRUCTURE
// ============================================

model Farm {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?
  code        String   @unique
  address     String
  city        String
  governorate String
  country     String   @default("EG")
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  totalArea   Decimal? @db.Decimal(12, 2) // in square meters
  usableArea  Decimal? @db.Decimal(12, 2)
  status      String   @default("ACTIVE") // ACTIVE, INACTIVE, MAINTENANCE
  establishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  manager     User?       @relation("FarmManager", fields: [managerId], references: [id], onDelete: SetNull)
  buildings   FarmBuilding[]
  pens        Pen[]
  animals     Animal[]
  projects    Project[]
  inventory   FeedInventory[]
  expenses    Expense[]
  tasks       Task[]
  employees   FarmEmployee[]
  workOrders  WorkOrder[]
  risks       RiskRegister[]
  ledgerEntries LedgerEntry[]
  movementsOut AnimalMovement[] @relation("FromFarmMovements")

  @@index([code])
  @@index([managerId])
  @@index([status])











  @@map("farms")

}

model FarmBuilding {
  id          String   @id @default(uuid())
  farmId      String
  name        String
  nameEn      String?
  code        String
  type        String   // PEN, STORAGE, OFFICE, VET_CLINIC, FEED_MILL, OTHER
  area        Decimal? @db.Decimal(10, 2)
  capacity    Int?
  floors      Int      @default(1)
  status      String   @default("ACTIVE")
  constructedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm   Farm   @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pens   Pen[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([type])

  @@map("farm_buildings")

}

model Pen {
  id            String   @id @default(uuid())
  farmId        String
  buildingId    String?
  name          String
  code          String
  type          String   // FATTENING, DAIRY, BREEDING, QUARANTINE, ISOLATION, CALVING
  area          Decimal? @db.Decimal(10, 2)
  capacity      Int
  currentCount  Int      @default(0)
  status        String   @default("ACTIVE") // ACTIVE, MAINTENANCE, EMPTY, QUARANTINE
  floorType     String?  // CONCRETE, SAND, RUBBER_MAT, OTHER
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  farm      Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  building  FarmBuilding? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  animals   Animal[]
  movementsFrom AnimalMovement[] @relation("FromPenMovements")
  feedConsumptions FeedConsumption[]
  ledgerEntries LedgerEntry[]

  @@unique([farmId, code])
  @@unique([buildingId, code])
  @@index([farmId])
  @@index([buildingId])
  @@index([status])


  @@map("pens")

}

model FarmEmployee {
  id          String   @id @default(uuid())
  farmId      String
  userId      String
  role        String   // MANAGER, SUPERVISOR, WORKER, VET_TECH, FEED_TECH, MAINTENANCE
  hireDate    DateTime
  endDate     DateTime?
  salary      Decimal? @db.Decimal(12, 2)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
  @@map("farm_employees")
}

// ============================================
// ANIMALS
// ============================================

model Animal {
  id              String       @id @default(uuid())
  farmId          String
  penId           String?
  animalId        String       @unique // Human-readable ID (e.g., THR-001-001)
  tagNumber       String?      @unique // Ear tag / RFID
  qrCode          String?      @unique
  type            AnimalType
  breed           String
  gender          String       // MALE, FEMALE
  dateOfBirth     DateTime?
  ageMonths       Int?
  weight          Decimal?     @db.Decimal(8, 2) // Current weight in kg
  purchaseWeight  Decimal?     @db.Decimal(8, 2)
  purchasePrice   Decimal?     @db.Decimal(15, 2)
  purchaseCurrency String      @default("EGP")
  sireId          String?      // Father animal ID
  damId           String?      // Mother animal ID
  healthStatus    HealthStatus @default(HEALTHY)
  status          AnimalStatus @default(ACTIVE)
  location        String?      // Current pen/location detail
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  farm        Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pen         Pen?           @relation(fields: [penId], references: [id], onDelete: SetNull)
  project     Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  feedConsumptions FeedConsumption[]
  tasks        Task[]
  risks        RiskRegister[]
  insurancePolicies InsurancePolicy[]
  ledgerEntries LedgerEntry[]
  media       AnimalMedia[]
  healthRecords HealthRecord[]
  weightRecords WeightRecord[]
  feedRecords  FeedRecord[]
  veterinaryReports VeterinaryReport[]
  movements    AnimalMovement[]
  projectAnimals ProjectAnimal[]
  sire         Animal?       @relation("Sire", fields: [sireId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([penId])
  @@index([projectId])
  @@index([animalId])
  @@index([tagNumber])
  @@index([qrCode])
  @@index([type])
  @@index([status])
  @@index([healthStatus])



    vaccinations Vaccination[]






    expenses Expense[]

    sales Sale[]





  @@map("animals")

}

model AnimalMedia {
  id          String   @id @default(uuid())
  animalId    String
  type        String   // IMAGE, VIDEO, DOCUMENT
  url         String
  thumbnailUrl String?
  fileName    String
  fileSize    Int
  mimeType    String
  takenAt     DateTime?
  uploadedBy  String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([type])
  @@map("animal_media")

}

model AnimalMovement {
  id            String   @id @default(uuid())
  animalId      String
  fromPenId     String?
  reason        String   // TRANSFER, SALE, MEDICAL, BREEDING, QUARANTINE, OTHER
  movedBy       String
  movedAt       DateTime @default(now())
  createdAt     DateTime @default(now())

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fromPen   Pen?   @relation("FromPenMovements", fields: [fromPenId], references: [id], onDelete: SetNull)
  fromFarm  Farm?  @relation("FromFarmMovements", fields: [fromFarmId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([movedAt])
  @@map("animal_movements")

}

// ============================================
// HEALTH & VETERINARY
// ============================================

model HealthRecord {
  id              String   @id @default(uuid())
  animalId        String
  recordedBy      String   // User ID (veterinarian or farm employee)
  recordType      String   // EXAMINATION, VACCINATION, MEDICATION, TREATMENT, SURGERY, LAB_TEST, CHECKUP
  title           String
  description     String?
  durationDays    Int?
  startDate       DateTime
  endDate         DateTime?
  cost            Decimal? @db.Decimal(12, 2)
  currency        String   @default("EGP")
  attachments     String[] // URLs
  isCritical      Boolean  @default(false)
  status          String   @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([recordType])
  @@index([startDate])
  @@index([followUpDate])
  @@map("health_records")

}

model Vaccination {
  id              String   @id @default(uuid())
  animalId        String
  vaccineName     String
  vaccineType     String   // VIRAL, BACTERIAL, PARASITIC, OTHER
  manufacturer    String?
  expiryDate      DateTime?
  administeredBy  String
  administeredAt  DateTime
  route           String?  // INTRAMUSCULAR, SUBCUTANEOUS, ORAL, NASAL
  site            String?  // Injection site
  cost            Decimal? @db.Decimal(10, 2)
  currency        String   @default("EGP")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([vaccineName])
  @@index([administeredAt])
  @@index([nextDueDate])
  @@map("vaccinations")

}

model VeterinaryReport {
  id              String   @id @default(uuid())
  animalId        String
  veterinarianId  String
  reportType      String   // ROUTINE_CHECKUP, EMERGENCY, PRE_PURCHASE, PRE_SALE, MORTALITY, OUTBREAK
  examinationDate DateTime
  temperature     Decimal? @db.Decimal(4, 1)
  heartRate       Int?
  bodyConditionScore Int? // 1-5
  generalAppearance String?
  findings        String
  followUpDate    DateTime?
  isApproved      Boolean  @default(false)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  animal       Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  veterinarian User   @relation(fields: [veterinarianId], references: [id], onDelete: Restrict)
  attachments  ReportAttachment[]

  @@index([animalId])
  @@index([veterinarianId])
  @@index([examinationDate])
  @@index([reportType])

  @@map("veterinary_reports")

}

model ReportAttachment {
  id              String   @id @default(uuid())
  reportId        String
  fileUrl         String
  fileName        String
  fileSize        Int
  mimeType        String
  description     String?
  uploadedAt      DateTime @default(now())

  report VeterinaryReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_attachments")
}

// ============================================
// FEED MANAGEMENT
// ============================================

model FeedType {
  id              String   @id @default(uuid())
  name            String
  nameEn          String?
  category        String   // ROUGHAGE, CONCENTRATE, SUPPLEMENT, MINERAL, VITAMIN, ADDITIVE
  unit            String   // KG, TON, BAG, LITER
  proteinPercent  Decimal? @db.Decimal(5, 2)
  energyMcalKg    Decimal? @db.Decimal(6, 3)
  fiberPercent    Decimal? @db.Decimal(5, 2)
  moisturePercent Decimal? @db.Decimal(5, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  inventory FeedInventory[]
  recipes   FeedRecipeIngredient[]
  quotationItems QuotationItem[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]

  @@index([category])
  @@index([isActive])


    feedRecords FeedRecord[]




  @@map("feed_types")

}

model FeedInventory {
  id              String   @id @default(uuid())
  farmId          String
  feedTypeId      String
  supplierId      String?
  quantity        Decimal  @db.Decimal(12, 3) // Current stock
  unit            String
  unitCost        Decimal  @db.Decimal(12, 3)
  currency        String   @default("EGP")
  totalCost       Decimal  @db.Decimal(15, 2)
  receivedDate    DateTime
  expiryDate      DateTime?
  status          String   @default("AVAILABLE") // AVAILABLE, RESERVED, CONSUMED, EXPIRED, SPOILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  farm      Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  feedType  FeedType  @relation(fields: [feedTypeId], references: [id], onDelete: Restrict)
  supplier  Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  consumption FeedConsumption[]

  @@index([farmId])
  @@index([feedTypeId])
  @@index([status])
  @@index([expiryDate])
    feedRecords FeedRecord[]


  @@map("feed_inventory")

}

model FeedRecipe {
  id          String   @id @default(uuid())
  name        String
  nameEn      String?
  animalType  AnimalType?
  lifeStage   String?  // CALF, GROWING, FATTENING, LACTATING, DRY, BREEDING
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients FeedRecipeIngredient[]

  @@index([animalType])
  @@index([isActive])

    feedRecords FeedRecord[]

  @@map("feed_recipes")

}

model FeedRecipeIngredient {
  id            String   @id @default(uuid())
  recipeId      String
  feedTypeId    String
  percentage    Decimal  @db.Decimal(5, 2) // Percentage of total ration
  amountPerHead Decimal  @db.Decimal(8, 3) // Amount per animal per day
  unit          String
  sortOrder     Int      @default(0)

  recipe   FeedRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  feedType FeedType   @relation(fields: [feedTypeId], references: [id], onDelete: Restrict)

  @@unique([recipeId, feedTypeId])
  @@map("feed_recipe_ingredients")
}

model FeedRecord {
  id              String   @id @default(uuid())
  animalId        String
  feedTypeId      String
  inventoryId     String?
  fedBy           String
  fedAt           DateTime
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String
  cost            Decimal  @db.Decimal(12, 2)
  currency        String   @default("EGP")
  feedingTime     String?  // MORNING, NOON, EVENING, NIGHT
  createdAt       DateTime @default(now())

  animal     Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  feedType   FeedType      @relation(fields: [feedTypeId], references: [id], onDelete: Restrict)
  inventory  FeedInventory? @relation(fields: [inventoryId], references: [id], onDelete: SetNull)
  recipe     FeedRecipe?   @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([animalId])
  @@index([fedAt])
  @@index([feedTypeId])
  @@map("feed_records")

}

model FeedConsumption {
  id              String   @id @default(uuid())
  inventoryId     String
  animalId        String?
  consumedBy      String
  consumedAt      DateTime
  quantity        Decimal  @db.Decimal(10, 3)
  unit            String
  cost            Decimal  @db.Decimal(12, 2)
  currency        String   @default("EGP")
  purpose         String   // DAILY_FEEDING, SUPPLEMENT, MEDICATION_CARRIER, OTHER
  createdAt       DateTime @default(now())

  inventory FeedInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  animal    Animal?       @relation(fields: [animalId], references: [id], onDelete: SetNull)
  pen       Pen?          @relation(fields: [penId], references: [id], onDelete: SetNull)
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([consumedAt])
  @@index([animalId])
  @@index([penId])
  @@index([projectId])
  @@map("feed_consumption")

}

// ============================================
// PROJECTS & INVESTMENTS
// ============================================

model Project {
  id                  String        @id @default(uuid())
  farmId              String
  name                String
  nameEn              String?
  code                String        @unique
  animalType          AnimalType
  breed               String
  purpose             String        // FATTENING, DAIRY, BREEDING, RESALE
  status              ProjectStatus @default(DRAFT)
  startDate           DateTime?
  totalShares         Int
  availableShares     Int
  sharePrice          Decimal       @db.Decimal(15, 2)
  shareCurrency       String        @default("EGP")
  minSharesPerInvestor Int          @default(1)
  maxSharesPerInvestor Int?
  totalBudget         Decimal       @db.Decimal(18, 2)
  fundedAmount        Decimal       @db.Decimal(18, 2) @default(0)
  expectedReturnRate  Decimal       @db.Decimal(5, 2) // Annual percentage
  riskLevel           RiskLevel     @default(MEDIUM)
  createdBy           String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  farm            Farm              @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals         Animal[]
  projectAnimals  ProjectAnimal[]
  shares          ProjectShare[]
  reservations    ShareReservation[]
  investments     Investment[]
  creator         User              @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  expenses        Expense[]
  weightRecords   WeightRecord[]
  feedRecords     FeedRecord[]
  veterinaryReports VeterinaryReport[]
