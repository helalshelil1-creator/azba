{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testTimeout": 120000,
  "moduleNameMapper": {
    "^@azba/shared$": "<rootDir>/../packages/shared/src",
    "^@azba/database$": "<rootDir>/../packages/database/src"
  }
}
