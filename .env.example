# AZBA Monorepo — نسخة مرجعية من متغيرات البيئة
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/azba?schema=public"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-long-random-string"

# مطلوب في الإنتاج: JWT_SECRET و JWT_REFRESH_SECRET (32 حرفًا على الأقل) وإلا يرفض الخادم التشغيل
# رابط الموقع الذي يظهر في رسالة استعادة كلمة المرور
APP_URL="http://localhost:3000"
# SMTP لإرسال بريد استعادة كلمة المرور (اختياري؛ بدونه لا يُرسل بريد)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# اضبطها false لتعطيل الدفع التجريبي (الدفع الحقيقي غير مربوط بعد)
PAYMENTS_SANDBOX_ENABLED="true"
