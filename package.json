{
  "name": "azba",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate --workspace=packages/database",
    "db:push": "npm run db:push --workspace=packages/database",
    "db:studio": "npm run db:studio --workspace=packages/database",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "next": "^15.5.29",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "lodash": "^4.18.1",
    "js-yaml": "^4.3.2",
    "qs": "^6.17.1",
    "postcss": "^8.5.33",
    "body-parser": "^1.20.9",
    "multer": "^2.5.0",
    "file-type": "^21.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
