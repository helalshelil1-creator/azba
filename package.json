{
  "name": "azba-api-deploy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "cd packages/database && npx prisma generate && cd ../../apps/api && npx nest build",
    "start": "node apps/api/dist/main.js"
  },
  "overrides": {
    "qs": "6.17.1",
    "multer": "2.5.0",
    "lodash": "4.18.1",
    "js-yaml": "4.3.2",
    "file-type": "21.3.4",
    "@nestjs/platform-express": {
      "body-parser": "1.20.9",
      "express": {
        "body-parser": "1.20.9"
      }
    },
    "uuid": "11.1.1"
  }
}
